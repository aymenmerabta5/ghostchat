# systemd user unit for `ghostchat --relay` (docs/LINUX.md "Headless relay").
[Unit]
Description=ghostchat mesh relay (no window)
After=bluetooth.target network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/ghostchat --relay
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
